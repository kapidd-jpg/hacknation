# =============================================================================
# PintarKuy - contoh konfigurasi LOCAL DEVELOPMENT.
# SALIN file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# PENTING: file ini untuk DB LOKAL saja. JANGAN pernah menaruh kredensial
# database produksi (TiDB Cloud) atau kredensial lain di sini.
# =============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database LOKAL (MySQL di mesin sendiri). Bukan server produksi. ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# TiDB Cloud butuh true (SSL via CA). Untuk MySQL lokal cukup false.
DB_MYSQL_SSL=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# --- Session ---
# PRODUKSI (serverless/Vercel): WAJIB SESSION_DRIVER=database + sesuaikan
# SESSION_SECURE_COOKIE=true (HTTPS). Jangan biarkan 'file' di serverless —
# filesystem ephemeral => sesi hilang/bergantian antar instance => 403 acak.
# Development lokal HTTP: set SESSION_SECURE_COOKIE=false agar tidak login-loop.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cookie hanya dikirim lewat HTTPS. Set false saat development via HTTP non-SSL.
# CHECK: pastikan pair (APP_ENV, APP_DEBUG, SESSION_SECURE_COOKIE) konsisten:
#   production => APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true
#   lokal      => APP_ENV=local,      APP_DEBUG=true,  SESSION_SECURE_COOKIE=false
SESSION_SECURE_COOKIE=true

# --- Proxy / TrustProxies ---
# Kosongkan di Vercel (default middleware aman). Bersihkan basis IP ketika
# dipasang di belakang proxy/load-balancer: mencegah rate-limiter di-bypass
# via header X-Forwarded-For spoof. Contoh: TRUSTED_PROXIES=1.2.3.4/32
TRUSTED_PROXIES=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
